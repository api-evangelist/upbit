{
  "opencollection": "1.0.0",
  "info": {
    "name": "Upbit REST Exchange - Account API",
    "version": "1.3.2"
  },
  "items": [
    {
      "info": {
        "name": "Exchange - Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account balances",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.upbit.com/v1/accounts",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns all asset balances for the authenticated account including available and locked amounts."
        }
      ]
    }
  ],
  "bundled": true
}